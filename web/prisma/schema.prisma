generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Required by @shopify/shopify-app-session-storage-prisma
model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  firstName   String?
  lastName    String?
  email       String?
  accountOwner Boolean  @default(false)
  locale      String?
  collaborator Boolean? @default(false)
  emailVerified Boolean? @default(false)
}

// One row per (shop, customer, product+variant) wishlist entry
model WishlistItem {
  id             String   @id @default(cuid())
  shop           String
  customerId     String // Shopify customer GID or a guest id stored client side
  productId      String // Shopify product GID
  variantId      String? // Optional variant GID
  productHandle  String
  productTitle   String
  productImage   String?
  price          String?
  createdAt      DateTime @default(now())

  @@unique([shop, customerId, productId, variantId])
  @@index([shop])
  @@index([shop, customerId])
  @@index([shop, productId])
}

// One row per shop, controls the Enable/Disable toggle from Settings
model ShopSettings {
  id              String   @id @default(cuid())
  shop            String   @unique
  enabled         Boolean  @default(true)
  wishlistPageUrl String?
  updatedAt       DateTime @updatedAt
}
