SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_customers,write_content,read_themes
HOST=
# Pooled connection (has "-pooler" in the hostname) - used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct/unpooled connection (same hostname minus "-pooler") - used only for migrations
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"
# Set this once the app is live on the Shopify App Store, e.g.
# https://apps.shopify.com/your-app-handle#modal-show=WriteReviewModal
APP_STORE_REVIEW_URL=
