{{ 'wishlist.css' | asset_url | stylesheet_tag }}

<div
  id="wishlist-app-config"
  data-shop="{{ shop.permanent_domain }}"
  data-customer-id="{{ customer.id | default: '' }}"
  data-wishlist-page-url="{{ block.settings.wishlist_page_url | default: '/pages/wishlist' }}"
  data-i18n-add-to-wishlist="{{ 'wishlist.add_to_wishlist' | t }}"
  data-i18n-remove-from-wishlist="{{ 'wishlist.remove_from_wishlist' | t }}"
  data-i18n-view-wishlist="{{ 'wishlist.view_wishlist' | t }}"
  data-i18n-remove-button="{{ 'wishlist.remove_button' | t }}"
  data-i18n-add-to-cart-button="{{ 'wishlist.add_to_cart_button' | t }}"
  data-i18n-added-to-cart="{{ 'wishlist.added_to_cart' | t }}"
  data-i18n-toast-added="{{ 'wishlist.toast_added' | t }}"
  data-i18n-empty="{{ 'wishlist.empty' | t }}"
  data-i18n-unavailable="{{ 'wishlist.unavailable' | t }}"
  style="display:none"
></div>

<script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Wishlist",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "wishlist_page_url",
      "label": "Wishlist page URL",
      "default": "/pages/wishlist",
      "info": "Create a page using the 'Wishlist Page' app block and paste its URL here."
    }
  ]
}
{% endschema %}
